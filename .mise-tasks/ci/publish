#!/usr/bin/env bash
#MISE raw=true
set -euo pipefail

source "$(dirname "$0")/../_lib.sh"
init
validate_version

step "Generating changelog"

git-cliff --config cliff.toml -vv --output CHANGELOG.md --tag "$TAG"
ok "Changelog generated"

git add Cargo.toml Cargo.lock docs/man.1.md docs/dotbee.1 CHANGELOG.md
if ! git diff --cached --exit-code >/dev/null 2>&1; then
    git commit -m "chore(release): prepare for v$VERSION"
    ok "Changes committed"
else
    ok "No changes to commit"
fi

step "Pushing main and creating tag"

git push origin main
ok "Changes pushed to main"

git tag "$TAG"
git push origin "$TAG"
ok "Tag $TAG created and pushed"

# github
step "Creating GitHub release"

RELEASE_BODY=$(git-cliff --config cliff.toml -vv --latest --strip header 2>/dev/null || true)

if [ -n "${CI:-}" ] && [ -z "${GITHUB_TOKEN:-}" ] && [ -z "${GH_TOKEN:-}" ]; then
    err "GITHUB_TOKEN or GH_TOKEN not set. Skipping release creation."
    err "Set the token and run: gh release create '$TAG' \$(find dist -type f) --notes '...'"
else
    mapfile -t ASSETS < <(find dist -type f | sort)
    gh release create "$TAG" "${ASSETS[@]}" \
        --notes "$RELEASE_BODY" \
        --title "dotbee $VERSION"
    ok "Release $TAG created"
fi

# crates.io
step "Publishing to crates.io"

if [ -n "${CI:-}" ] && [ -z "${CARGO_REGISTRY_TOKEN:-}" ]; then
    err "CARGO_REGISTRY_TOKEN not set. Skipping publish."
    err "Set the token and run: cargo publish"
else
    cargo publish
    ok "Published to crates.io"
fi
