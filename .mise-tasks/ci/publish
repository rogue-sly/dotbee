#!/usr/bin/env bash
set -euo pipefail

source "$(dirname "$0")/_lib.sh"
init
validate_version

step "Publishing to crates.io"

if [ -z "${CARGO_REGISTRY_TOKEN:-}" ]; then
  err "CARGO_REGISTRY_TOKEN not set. Skipping publish."
  err "Set the token and run: cargo publish"
else
  cargo publish
  ok "Published to crates.io"
fi
