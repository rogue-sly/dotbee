#!/usr/bin/env bash
#USAGE arg "target" help="Rust target triple (e.g. x86_64-unknown-linux-musl)"
#USAGE arg "artifact-name" help="Output artifact name (e.g. dotbee-linux-x86_64-musl)"
set -euo pipefail

source "$(dirname "$0")/../_lib.sh"
init
validate_version

TARGET="${usage_target:-}"
ARTIFACT="${usage_artifact_name:-}"

if [ -z "$TARGET" ] || [ -z "$ARTIFACT" ]; then
    err "Usage: mise run ci:build <target-triple> <artifact-name>"
    exit 1
fi

mkdir -p dist/bin

step "Building $ARTIFACT ($TARGET)"

cross build --release --target "$TARGET"

info "Staging binary..."
cp "target/$TARGET/release/dotbee" "dist/bin/$ARTIFACT"

ok "$ARTIFACT done"
