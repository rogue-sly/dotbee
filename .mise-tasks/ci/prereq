#!/usr/bin/env bash
set -euo pipefail

source "$(dirname "$0")/../_lib.sh"
init
validate_version

step "Checking prerequisites"

check_tool() {
    local name="$1"
    local hint="$2"
    if ! command -v "$name" >/dev/null 2>&1; then
        err "$name not found. $hint"
        exit 1
    fi
    ok "$name found"
}

check_tool gh "Install from https://cli.github.com/"
check_tool git-cliff "cargo install git-cliff"
check_tool nfpm "mise install nfpm"
check_tool pandoc "mise install pandoc"
check_tool cross "cargo install cross --git https://github.com/cross-rs/cross --locked"
