#!/usr/bin/env bash
set -euo pipefail

source "$(dirname "$0")/../_lib.sh"
init
validate_version

step "Checking prerequisites"

check_cargo_tool() {
    local name="$1"
    if ! cargo install --list 2>/dev/null | grep -q "^${name% *} "; then
        info "Installing $name..."
        cargo install "$name"
        ok "$name installed"
    else
        ok "$name found"
    fi
}

check_tool() {
    local name="$1"
    local hint="$2"
    if ! command -v "$name" >/dev/null 2>&1; then
        err "$name not found. $hint"
        exit 1
    fi
    ok "$name found"
}

check_tool gh "Install from https://cli.github.com/"
check_tool git-cliff "cargo install git-cliff"
check_tool nfpm "mise install nfpm"
check_tool pandoc "mise install pandoc"
check_tool zig "mise install zig"
check_cargo_tool cargo-zigbuild

if [ "$(uname -m)" != "aarch64" ]; then
    check_tool aarch64-linux-gnu-gcc "apt install gcc-aarch64-linux-gnu"
fi

setup_ndk_env
