#!/usr/bin/env bash
#MISE depends=["ci:checksums"]
set -euo pipefail

source "$(dirname "$0")/_lib.sh"
init
validate_version

step "Creating GitHub release"

RELEASE_BODY=$(git-cliff --config cliff.toml -vv --latest --strip header 2>/dev/null || true)

if [ -z "${GITHUB_TOKEN:-}" ] && [ -z "${GH_TOKEN:-}" ]; then
  err "GITHUB_TOKEN or GH_TOKEN not set. Skipping release creation."
  err "Set the token and run: gh release create '$TAG' dist/* --notes '...'"
else
  gh release create "$TAG" dist/* \
    --notes "$RELEASE_BODY" \
    --title "dotbee $VERSION"
  ok "Release $TAG created"
fi
