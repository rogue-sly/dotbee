#!/usr/bin/env bash
#USAGE arg "[increment]" help="The increment type (major, minor, bugfix) or a literal version" {
#USAGE   choices "bugfix" "minor" "major"
#USAGE }
set -euo pipefail

source "$(dirname "$0")/../_lib.sh"
init

INCREMENT="${usage_increment:-}"
if [ -z "$INCREMENT" ]; then
    err "No increment provided. Run: mise run ci:release <major|minor|bugfix|version>"
    exit 1
fi

if [ -n "$(git status --porcelain)" ]; then
    err "Working tree is not clean. Commit or stash changes first."
    exit 1
fi

step "Bumping version"

OLD_VERSION=$(grep -m 1 '^version = ' Cargo.toml | cut -d '"' -f 2)
IFS='.' read -r MAJOR MINOR PATCH <<<"$OLD_VERSION"

if [[ "$INCREMENT" == "major" ]]; then
    NEW_VERSION="$((MAJOR + 1)).0.0"
elif [[ "$INCREMENT" == "minor" ]]; then
    NEW_VERSION="$MAJOR.$((MINOR + 1)).0"
elif [[ "$INCREMENT" == "bugfix" ]]; then
    NEW_VERSION="$MAJOR.$MINOR.$((PATCH + 1))"
elif [[ "$INCREMENT" =~ ^[0-9]+\.[0-9]+\.[0-9]+$ ]]; then
    NEW_VERSION="$INCREMENT"
else
    err "Invalid increment type '$INCREMENT'. Use 'major', 'minor', 'bugfix', or a literal version (e.g., 1.2.3)."
    exit 1
fi

if [[ "$NEW_VERSION" == "$OLD_VERSION" ]]; then
    ok "Version is already $OLD_VERSION"
    exit 0
fi

sed -i "s/^version = \"$OLD_VERSION\"/version = \"$NEW_VERSION\"/" Cargo.toml
cargo check >/dev/null 2>&1
ok "Bumped $OLD_VERSION -> $NEW_VERSION"

git add Cargo.toml Cargo.lock
git commit -m "chore(release): prepare for v$NEW_VERSION"
ok "Bump committed"
